{
  "name": "air-desktop",
  "version": "1.0.0",
  "description": "AIR - Automated Intelligence Recorder",
  "main": "./core/dist/index.js",
  "author": "AIR Team",
  "private": true,
  "workspaces": [
    "core",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "echo skipping sqlite rebuild",
    "build": "npm --workspace core run build && npm --workspace packages/shared run build && npm --workspace packages/codegen run build && npm --workspace packages/mcp-server run build",
    "build:mcp": "npm run build",
    "mcp:stdio": "node scripts/air-mcp.cjs",
    "mcp:http": "node scripts/air-mcp.cjs --transport http",
    "typecheck:core": "tsc -p core/tsconfig.json --noEmit",
    "test": "vitest",
    "test:anchor": "playwright test packages/shared/__tests__/anchor-consistency.spec.ts --reporter=line",
    "test:anchors": "npm run test:anchor",
    "test:smoke:orangehrm": "playwright test packages/shared/__tests__/orangehrm-login-flow.smoke.spec.ts --reporter=line",
    "test:selector": "playwright test packages/shared/__tests__/selector-consistency.spec.ts --reporter=line",
    "lint": "eslint . --ext js,ts,tsx",
    "format": "prettier --write \"**/*.{js,ts,tsx,json}\""
  },
  "dependencies": {
    "html-encoding-sniffer": "5.0.0",
    "linkedom": "^0.18.0",
    "playwright": "^1.58.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.3.2",
    "tsx": "^4.22.4",
    "typescript": "5.6.3",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "html-encoding-sniffer": "5.0.0"
  }
}

{
  "name": "air-desktop",
  "version": "1.0.0",
  "description": "AIR - Automated Intelligence Recorder",
  "main": "./out/main/index.js",
  "author": "AIR Team",
  "private": true,
  "workspaces": [
    "core",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "echo skipping sqlite rebuild",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:core": "tsc -p core/tsconfig.json --noEmit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "vitest",
    "test:anchor": "playwright test packages/shared/__tests__/anchor-consistency.spec.ts --reporter=line",
    "test:anchors": "npm run test:anchor",
    "test:smoke:orangehrm": "playwright test packages/shared/__tests__/orangehrm-login-flow.smoke.spec.ts --reporter=line",
    "test:selector": "playwright test packages/shared/__tests__/selector-consistency.spec.ts --reporter=line",
    "lint": "eslint . --ext js,ts,tsx",
    "format": "prettier --write \"**/*.{js,ts,tsx,json}\""
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@xyflow/react": "^12.0.0",
    "dagre": "^0.8.5",
    "html-encoding-sniffer": "5.0.0",
    "linkedom": "^0.18.0",
    "playwright": "^1.58.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "reactflow": "^11.11.4",
    "zod": "3.23.0",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.27",
    "electron": "33.2.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.8",
    "prettier": "^3.3.2",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.22.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "html-encoding-sniffer": "5.0.0"
  }
}

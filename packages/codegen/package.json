{
  "name": "@air/codegen",
  "version": "0.1.0",
  "description": "AIR semantic timeline compressor and code generation service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "air": "bin/air.cjs",
    "air-trace": "bin/air-trace.cjs",
    "air-smoke": "bin/air-smoke.cjs",
    "air-smoke-summary": "bin/air-smoke-summary.cjs"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "review": "node bin/run-ts-cli.cjs air-review.ts",
    "review:list": "node bin/run-ts-cli.cjs air-review.ts --list",
    "trace": "node bin/run-ts-cli.cjs air-trace.ts",
    "trace:list": "node bin/run-ts-cli.cjs air-trace.ts --list",
    "smoke": "node bin/run-ts-cli.cjs air-smoke.ts",
    "smoke:summary": "node bin/run-ts-cli.cjs air-smoke-summary.ts"
  },
  "dependencies": {
    "@air/shared": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.3"
  }
}

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "resolveJsonModule": true,
    "types": ["node", "better-sqlite3", "vitest"]
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "bin/**/*.ts"
  ],
  "exclude": [
    "dist",
    "__tests__",
    "test-codegen.ts",
    "extract.ts"
  ]
}

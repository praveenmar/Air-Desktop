{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    /* 1. THE FIX: Set rootDir to the 'packages' folder so it includes 'shared' */
    "rootDir": "..", 
    "outDir": "./dist",

    "emitDeclarationOnly": true,
    "noEmit": false, 
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,

    "types": ["node", "vitest"],

    "paths": {
      "@air/shared": ["../shared/src/index.ts"],
      "@air/shared/*": ["../shared/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "bin/**/*.ts",
    "__tests__/**/*.ts",
    "test-codegen.ts",
    /* 2. IMPORTANT: You must also include the shared files so TS can 'see' them */
    "../shared/src/**/*.ts",
    "index.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    /* 1. Use 'bundler' for Vite/Electron projects */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,

    "paths": {
      "@core/*": ["./core/*"],
      "@src/*": ["./src/*"],
      "@electron/*": ["./electron/*"],
      "@air/shared": ["./packages/shared/src/index.ts"],
      "@air/shared/*": ["./packages/shared/src/*"],
      "@air/codegen": ["./packages/codegen/src/index.ts"],
      "@air/codegen/*": ["./packages/codegen/src/*"]
    }
  }
}
// Purpose: TypeScript configuration specific to the Node.js context (Main, Preload, Core).
// Prototype Origin: New file for Electron scaffolding.
// Changes: Excludes React/renderer code, targets Node environments.

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node", "electron"]
  },
  "include": [
    "electron/**/*",
    "core/**/*",
    "vite.config.ts"
  ]
}
